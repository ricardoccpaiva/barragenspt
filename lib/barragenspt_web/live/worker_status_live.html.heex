<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-5">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">
        Estado das atualizações de dados
      </h1>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Visão geral do estado das rotinas de atualização responsáveis por atualizar os dados do barragens.pt
      </p>
    </div>

    <section
      class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800/50">
      <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
        <thead class="bg-slate-50 dark:bg-slate-800">
          <tr class="text-left text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
            <th class="px-4 py-3 font-medium">Tipo</th>
            <th class="px-4 py-3 font-medium">Última execução</th>
            <th class="px-4 py-3 font-medium">Próxima execução</th>
            <th class="px-4 py-3 font-medium">Estado</th>
            <th class="px-4 py-3 font-medium">Linhas criadas</th>
            <th class="px-4 py-3 font-medium">Linhas atualizadas</th>
            <th class="px-4 py-3 font-medium">Duração</th>
            <th class="px-4 py-3 font-medium text-right">Histórico</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/70">
          <tr :for={row <- @summaries}>
            <td class="px-4 py-3">
              <div class="inline-flex items-center gap-1.5 text-slate-900 dark:text-slate-100">
                <span class="font-semibold">{row.worker_display_name}</span>
                <span
                  class="inline-flex rounded-full text-slate-400 dark:text-slate-500"
                  title={row.worker_description}
                  aria-label={row.worker_description}
                >
                  <.icon name="hero-information-circle" class="size-4" />
                </span>
              </div>
            </td>
            <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
              {format_datetime(row.last_run_at)}
            </td>
            <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
              <div>{format_datetime(row.next_run_at)}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">
                em {format_countdown(row.seconds_to_next)}
              </div>
            </td>
            <td class="px-4 py-3">
              <span class={status_badge_class(row.status)}>{row.status}</span>
            </td>
            <td class="px-4 py-3 text-slate-700 dark:text-slate-200">{row.rows_created}</td>
            <td class="px-4 py-3 text-slate-700 dark:text-slate-200">{row.rows_updated}</td>
            <td class="px-4 py-3 text-slate-700 dark:text-slate-200">
              {format_duration(row.duration_ms)}
            </td>
            <td class="px-4 py-3 text-right">
              <button id={"open-runs-#{row.worker_name}"} type="button" phx-click="open_runs_modal"
                phx-value-worker={row.worker}
                class="inline-flex size-8 items-center justify-center rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700"
                aria-label={"Ver últimas 30 execuções de #{row.worker_display_name}"} title="Ver últimas 30 execuções">
                <.icon name="hero-book-open" class="size-3.5" />
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </section>
  </div>

  <%= if @show_runs_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
      phx-click="close_runs_modal">
      <div
        class="max-h-[90vh] w-full max-w-5xl overflow-auto rounded-xl border border-slate-200 bg-white p-4 shadow-xl dark:border-slate-700 dark:bg-slate-800"
        phx-click="noop">
        <div class="mb-3 flex items-start justify-between">
          <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
              Últimas 30 execuções - {@modal_worker_name}
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Resumo agregado das execuções recentes.
            </p>
          </div>
          <button type="button" phx-click="close_runs_modal"
            class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700"
            aria-label="Fechar">
            <.icon name="hero-x-mark" class="size-5" />
          </button>
        </div>

        <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7">
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">Total</p>
            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
              {Map.get(@modal_summary, :total, 0)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">OK</p>
            <p class="text-sm font-semibold text-green-700 dark:text-green-300">
              {Map.get(@modal_summary, :ok_count, 0)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">Erros</p>
            <p class="text-sm font-semibold text-red-700 dark:text-red-300">
              {Map.get(@modal_summary, :error_count, 0)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">A correr</p>
            <p class="text-sm font-semibold text-sky-700 dark:text-sky-300">
              {Map.get(@modal_summary, :running_count, 0)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">Criadas</p>
            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
              {Map.get(@modal_summary, :total_created, 0)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">Atualizadas</p>
            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
              {Map.get(@modal_summary, :total_updated, 0)}
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-2 dark:border-slate-700">
            <p class="text-xs text-slate-500 dark:text-slate-400">Duração média</p>
            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
              {format_duration(Map.get(@modal_summary, :avg_duration_ms))}
            </p>
          </div>
        </div>

        <div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
          <table class="min-w-full divide-y divide-slate-200 text-sm dark:divide-slate-700">
            <thead class="bg-slate-50 dark:bg-slate-800">
              <tr class="text-left text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
                <th class="px-3 py-2 font-medium">Início</th>
                <th class="px-3 py-2 font-medium">Fim</th>
                <th class="px-3 py-2 font-medium">Estado</th>
                <th class="px-3 py-2 font-medium">Criadas</th>
                <th class="px-3 py-2 font-medium">Atualizadas</th>
                <th class="px-3 py-2 font-medium">Duração</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/70">
              <tr :for={run <- @modal_runs}>
                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">
                  {format_datetime(run.started_at)}
                </td>
                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">
                  {format_datetime(run.finished_at)}
                </td>
                <td class="px-3 py-2">
                  <span class={status_badge_class(run.status)}>{run.status}</span>
                </td>
                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">{run.rows_created}</td>
                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">{run.rows_updated}</td>
                <td class="px-3 py-2 text-slate-700 dark:text-slate-200">
                  {format_duration(run.duration_ms)}
                </td>
              </tr>
              <tr :if={@modal_runs==[]}>
                <td colspan="6" class="px-3 py-4 text-center text-slate-500 dark:text-slate-400">
                  Sem execuções registadas ainda.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% end %>
</Layouts.app>
