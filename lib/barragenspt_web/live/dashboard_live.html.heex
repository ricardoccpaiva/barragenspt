<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- Hero (+ compact login card for guests) --%>
    <%= if @signed_in? do %>
      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">
          barragens.pt · Dashboard
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
          Bem-vindo(a), <span
            class="text-brand-600 dark:text-brand-400">{user_display_name(@current_scope.user)}</span>.
        </h1>
        <p class="mt-3 max-w-xl text-base text-slate-500 dark:text-slate-400">
          Analisa dados hidrométricos, gera relatórios e monitoriza albufeiras portuguesas com notificações
          personalizados.
        </p>
      </div>
      <div class="mb-10">
        <div class="mb-4 flex items-end justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-50">Resumo da tua atividade</h2>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <.activity_stat_card label="Chamadas API" value={format_count(@activity_summary.api_calls)} sub=""
            icon="hero-key"
            icon_class="bg-violet-50 text-violet-600 ring-1 ring-violet-100 dark:bg-violet-950/40 dark:text-violet-400 dark:ring-violet-800/60" />
          <.activity_stat_card label="Acesso a dados" value={format_count(@activity_summary.data_views)} sub={"CSVs
            exportados: #{format_count(@activity_summary.data_exports)}"} icon="hero-chart-bar"
            icon_class="bg-teal-50 text-teal-600 ring-1 ring-teal-100 dark:bg-teal-950/40 dark:text-teal-400 dark:ring-teal-800/60" />
          <.activity_stat_card label="Relatórios" value={format_count(@activity_summary.reports_generated)} sub={"PDFs
            exportados: #{format_count(@activity_summary.report_pdf_exports)}"} icon="hero-chart-bar"
            icon_class="bg-sky-50 text-sky-600 ring-1 ring-sky-100 dark:bg-sky-950/40 dark:text-sky-400 dark:ring-sky-800/60" />
          <.activity_stat_card label="Triggers" value={format_count(notification_trigger_count(@activity_summary,
            :total))} sub={"#{format_count(notification_trigger_count(@activity_summary, :active))} ativas ·
            #{format_count(notification_trigger_count(@activity_summary, :inactive))} inativas"} icon="hero-bell-alert"
            icon_class="bg-amber-50 text-amber-600 ring-1 ring-amber-100 dark:bg-amber-950/40 dark:text-amber-400 dark:ring-amber-800/60" />
          <.activity_stat_card label="Notificações enviadas"
            value={format_count(notification_delivery_count(@activity_summary))}
            sub={"#{format_count(notification_channel_count(@activity_summary, "email" ))} e-mail ·
            #{format_count(notification_channel_count(@activity_summary, "telegram" ))} Telegram"}
            icon="hero-paper-airplane"
            icon_class="bg-rose-50 text-rose-600 ring-1 ring-rose-100 dark:bg-rose-950/40 dark:text-rose-400 dark:ring-rose-800/60" />
        </div>
      </div>
      <% else %>
        <div class="mb-10 flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-500 dark:text-brand-400">
              barragens.pt · Dashboard
            </p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
              O teu centro de análise e monitorização hídrica.
            </h1>
            <p class="mt-3 max-w-xl text-base text-slate-500 dark:text-slate-400">
              Analisa dados hidrométricos, gera relatórios e monitoriza albufeiras portuguesas com notificações
              personalizados.
            </p>
          </div>
          <div
            class="w-full shrink-0 rounded-xl border border-brand-200/90 bg-gradient-to-br from-brand-50/95 to-sky-50/80 p-3.5 shadow-sm dark:border-brand-800/60 dark:from-brand-950/50 dark:to-slate-900/80 dark:shadow-none lg:max-w-[min(100%,20rem)] lg:self-start xl:max-w-[22rem]">
            <p class="text-xs font-semibold text-brand-900 dark:text-brand-100">
              Conta gratuita · Google ou e-mail
            </p>
            <p class="mt-1.5 text-xs leading-snug text-slate-600 dark:text-slate-400">
              Inicia sessão para teres acesso completo a todas as funcionalidades.
            </p>
            <div class="mt-3 flex flex-col gap-2">
              <.link navigate={~p"/users/log-in"}
                class="inline-flex w-full items-center justify-center rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1 dark:focus:ring-offset-slate-900">
                Iniciar sessão
              </.link>
              <.link navigate={~p"/users/register"}
                class="inline-flex w-full items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-800 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700">
                Criar conta
              </.link>
            </div>
          </div>
        </div>
        <% end %>
</Layouts.app>