<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100">Admin Insights</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Monitorização operacional de API e Notificações.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <.live_component
          module={BarragensptWeb.EvaluateNotificationsShortcutComponent}
          id="admin-evaluate-notifications"
        />
        <div class="inline-flex overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-600 dark:bg-slate-800">
          <%= for tab <- @tabs do %>
            <button
              type="button"
              phx-click="set_tab"
              phx-value-tab={tab}
              class={[
                "px-3 py-1.5 text-sm font-medium capitalize",
                tab == @tab && "bg-brand-600 text-white",
                tab != @tab &&
                  "text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700"
              ]}
            >
              {tab}
            </button>
          <% end %>
        </div>
        <div class="inline-flex overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-600 dark:bg-slate-800">
          <%= for w <- @windows do %>
            <button
              type="button"
              phx-click="set_window"
              phx-value-window={w}
              class={[
                "px-3 py-1.5 text-sm font-medium",
                w == @window && "bg-brand-600 text-white",
                w != @window &&
                  "text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700"
              ]}
            >
              {w}
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <%= if @tab == "api" do %>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <.kpi title={"Requests #{@window}"} value={fmt_int(@totals.requests)} />
        <.kpi title="Active API tokens" value={fmt_int(@totals.active_api_tokens)} />
        <.kpi title="Users with API usage" value={fmt_int(@totals.users_with_usage)} />
        <.kpi title="Spike buckets (>200)" value={fmt_int(@totals.spike_buckets)} />
      </div>
    <% else %>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <.kpi title={"Notification events #{@window}"} value={fmt_int(@notifications_totals.triggered_events)} />
        <.kpi title={"Notified events #{@window}"} value={fmt_int(@notifications_totals.notified_events)} />
        <.kpi title="Active notifications" value={fmt_int(@notifications_totals.active_alerts)} />
        <.kpi title="Users with notification events" value={fmt_int(@notifications_totals.users_with_alert_events)} />
      </div>
    <% end %>

    <div class="grid gap-4 xl:grid-cols-12">
      <section class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-600 dark:bg-slate-800/50 xl:col-span-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          <%= if @tab == "api", do: "API requests over time", else: "Notification events over time" %>
        </h2>
        <%= if (@tab == "api" && (@usage_chart.labels == [] || @usage_chart.datasets == [])) || (@tab == "notifications" && (@notifications_chart.labels == [] || @notifications_chart.datasets == [])) do %>
          <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">Sem dados para o período.</p>
        <% else %>
          <div id="admin-product-chart" phx-hook="AdminProductChart" class="mt-3 h-56 w-full">
            <canvas class="h-full w-full"></canvas>
          </div>
        <% end %>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-600 dark:bg-slate-800/50 xl:col-span-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          Usage concentration
        </h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <%= if @tab == "api" do %>
            Top users e top tokens ajudam a identificar concentração de tráfego.
          <% else %>
            Top users e top notificações ajudam a identificar concentração de disparos.
          <% end %>
        </p>
      </section>
    </div>

    <%= if @tab == "api" do %>
      <div class="grid gap-4 xl:grid-cols-12">
        <section class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-600 dark:bg-slate-800/50 xl:col-span-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Top users by API requests
          </h2>
          <div class="mt-3 space-y-2 text-sm">
            <%= if @top_users == [] do %>
              <p class="text-slate-500 dark:text-slate-400">Sem atividade.</p>
            <% else %>
              <%= for u <- @top_users do %>
                <div>
                  <div class="mb-1 flex justify-between">
                    <span class="truncate pr-3 text-slate-600 dark:text-slate-300">{u.email}</span>
                    <span class="font-semibold text-slate-900 dark:text-slate-100">{fmt_int(u.request_count)}</span>
                  </div>
                  <div class="h-2 rounded bg-slate-200 dark:bg-slate-700">
                    <div class="h-2 rounded bg-brand-500" style={"width: #{top_pct(u.request_count, @top_users, :request_count)}%"}></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-600 dark:bg-slate-800/50 xl:col-span-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Top tokens by API requests
          </h2>
          <div class="mt-3 space-y-2 text-sm">
            <%= if @top_tokens == [] do %>
              <p class="text-slate-500 dark:text-slate-400">Sem atividade.</p>
            <% else %>
              <%= for t <- @top_tokens do %>
                <div>
                  <div class="mb-1 flex justify-between">
                    <span class="truncate pr-3 font-mono text-slate-600 dark:text-slate-300">{t.token_prefix}…</span>
                    <span class="font-semibold text-slate-900 dark:text-slate-100">{fmt_int(t.request_count)}</span>
                  </div>
                  <div class="h-2 rounded bg-slate-200 dark:bg-slate-700">
                    <div class="h-2 rounded bg-sky-500" style={"width: #{top_pct(t.request_count, @top_tokens, :request_count)}%"}></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>
      </div>
    <% else %>
      <div class="grid gap-4 xl:grid-cols-12">
        <section class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-600 dark:bg-slate-800/50 xl:col-span-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Top users by notification events
          </h2>
          <div class="mt-3 space-y-2 text-sm">
            <%= if @top_notification_users == [] do %>
              <p class="text-slate-500 dark:text-slate-400">Sem atividade.</p>
            <% else %>
              <%= for u <- @top_notification_users do %>
                <div>
                  <div class="mb-1 flex justify-between">
                    <span class="truncate pr-3 text-slate-600 dark:text-slate-300">{u.email}</span>
                    <span class="font-semibold text-slate-900 dark:text-slate-100">{fmt_int(u.event_count)}</span>
                  </div>
                  <div class="h-2 rounded bg-slate-200 dark:bg-slate-700">
                    <div class="h-2 rounded bg-brand-500" style={"width: #{top_pct(u.event_count, @top_notification_users, :event_count)}%"}></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-600 dark:bg-slate-800/50 xl:col-span-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Top notifications by events
          </h2>
          <div class="mt-3 space-y-2 text-sm">
            <%= if @top_notifications == [] do %>
              <p class="text-slate-500 dark:text-slate-400">Sem atividade.</p>
            <% else %>
              <%= for a <- @top_notifications do %>
                <div>
                  <div class="mb-1 flex justify-between">
                    <span class="truncate pr-3 text-slate-600 dark:text-slate-300">{"#{a.subject_name} (##{a.notification_id})"}</span>
                    <span class="font-semibold text-slate-900 dark:text-slate-100">{fmt_int(a.event_count)}</span>
                  </div>
                  <div class="h-2 rounded bg-slate-200 dark:bg-slate-700">
                    <div class="h-2 rounded bg-sky-500" style={"width: #{top_pct(a.event_count, @top_notifications, :event_count)}%"}></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>
      </div>
    <% end %>
  </div>
</Layouts.app>
